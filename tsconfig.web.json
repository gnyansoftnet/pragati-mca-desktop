{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
     "src/renderer/src/**/*",
    "src/preload/*.d.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
     "noUnusedLocals": false,
      "noUnusedParameters": false,
      "strict": false,
    "composite": true,
    "jsx": "react-jsx",
     "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}